# Copie ce fichier en .env (jamais commité) et remplis-le. Ne colle JAMAIS tes clés dans un chat.

# --- 3 clés Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- 3 clés Groq (https://console.groq.com/keys) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --- Alpaca (https://app.alpaca.markets) : clés du compte PAPER ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Argent réel : ALPACA_PAPER=false ET LIVE_TRADING_CONFIRMATION=JE_COMPRENDS_LES_RISQUES (déconseillé)
LIVE_TRADING_CONFIRMATION=

# true = les IA réfléchissent mais aucun ordre n'est envoyé
DRY_RUN=false

# --- Optionnel : notifications sur le téléphone (application gratuite ntfy, https://ntfy.sh) ---
# Choisis un nom de sujet difficile à deviner, abonne-toi à ce nom dans l'application.
NTFY_TOPIC=

# --- Optionnel : lecture des messages Reddit (https://www.reddit.com/prefs/apps, type « script ») ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optionnel : recherche web de secours quand le quota Gemini est épuisé (https://tavily.com) ---
# 1 000 recherches gratuites par mois, sans carte bancaire. Sans cette clé, le secours passe par
# Google Actualités et Wikipédia (sans clé, mais sans réponse rédigée).
TAVILY_API_KEY=

# Optionnel : limites de risque (compte de l'équipe)
# MAX_POSITION_PCT=15
# MIN_CASH_PCT=5
# MAX_POSITIONS=10
# MAX_ORDERS_PER_SESSION=5
# MAX_STOP_DISTANCE_PCT=15
# MIN_REWARD_RISK=1.5
# MAX_SECTOR_PCT=35
# Frein d'urgence : plus aucun achat si le compte perd ce % en un jour / en une semaine
# FREIN_JOUR_PCT=3
# FREIN_SEMAINE_PCT=7
# Stop suiveur : à +5 % le stop remonte au prix d'achat, à +10 % il suit le cours à 5 % (0 = désactivé)
# STOP_SUIVEUR_PCT=5
# STOP_SUIVEUR_DISTANCE_PCT=5
# Toute l'équipe à chaque séance de suivi, même quand rien ne bouge
# SUIVI_COMPLET=false
